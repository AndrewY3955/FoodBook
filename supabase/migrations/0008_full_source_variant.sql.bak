-- Community layer
-- =====================================================================
alter table public.substitution_suggestions enable row level security;
alter table public.substitution_suggestions force row level security;

drop policy if exists substitutions_select_anon on public.substitution_suggestions;
create policy substitutions_select_anon
  on public.substitution_suggestions for select
  to anon
  using (public.recipe_is_public(recipe_id));

drop policy if exists substitutions_select on public.substitution_suggestions;
create policy substitutions_select
  on public.substitution_suggestions for select
  to authenticated
  using (
    public.recipe_is_public(recipe_id)
    or exists (
      select 1 from public.recipes r
       where r.id = substitution_suggestions.recipe_id
         and public.is_library_member(r.library_id)
    )
  );

drop policy if exists substitutions_insert_own on public.substitution_suggestions;
create policy substitutions_insert_own
  on public.substitution_suggestions for insert
  to authenticated
  with check (
    created_by = (select auth.uid())
    and public.recipe_is_public(recipe_id)
  );

drop policy if exists substitutions_update_own on public.substitution_suggestions;
create policy substitutions_update_own
  on public.substitution_suggestions for update
  to authenticated
  using (created_by = (select auth.uid()))
  with check (created_by = (select auth.uid()));

drop policy if exists substitutions_delete_own on public.substitution_suggestions;
create policy substitutions_delete_own
  on public.substitution_suggestions for delete
  to authenticated
  using (created_by = (select auth.uid()));

alter table public.substitution_votes enable row level security;
alter table public.substitution_votes force row level security;

drop policy if exists votes_select on public.substitution_votes;
create policy votes_select
  on public.substitution_votes for select
  to authenticated
  using (
    exists (
      select 1
        from public.substitution_suggestions s
       where s.id = substitution_votes.suggestion_id
         and public.recipe_is_public(s.recipe_id)
    )
  );

drop policy if exists votes_insert_own on public.substitution_votes;
create policy votes_insert_own
  on public.substitution_votes for insert
  to authenticated
  with check (user_id = (select auth.uid()));

drop policy if exists votes_update_own on public.substitution_votes;
create policy votes_update_own
  on public.substitution_votes for update
  to authenticated
  using (user_id = (select auth.uid()))
  with check (user_id = (select auth.uid()));

drop policy if exists votes_delete_own on public.substitution_votes;
create policy votes_delete_own
  on public.substitution_votes for delete
  to authenticated
  using (user_id = (select auth.uid()));

-- cook_logs: append-only. SELECT and INSERT policies only; the absence
-- of UPDATE/DELETE policies is the control that makes history immutable
-- from the client.
alter table public.cook_logs enable row level security;
alter table public.cook_logs force row level security;

drop policy if exists cook_logs_select on public.cook_logs;
create policy cook_logs_select
  on public.cook_logs for select
  to authenticated
  using (
    public.recipe_is_public(recipe_id)
    or exists (
      select 1 from public.recipes r
       where r.id = cook_logs.recipe_id
         and public.is_library_member(r.library_id)
    )
  );

drop policy if exists cook_logs_insert on public.cook_logs;
create policy cook_logs_insert
  on public.cook_logs for insert
  to authenticated
  with check (
    public.recipe_is_public(recipe_id)
    or exists (
      select 1 from public.recipes r
       where r.id = cook_logs.recipe_id
         and public.is_library_member(r.library_id)
    )
  );
-- =====================================================================
-- 0005_storage_policies.sql
-- Recipe cover images.
--
-- One bucket, private. `public = false` means Supabase will not serve
-- /object/public/... for it at all; reads go through a signed URL or an
-- authenticated request, and in both cases the policies below decide.
--
-- Object key layout is fixed:  <library_uuid>/<recipe_uuid>/cover.<ext>
-- The policies read the tenant straight out of the key, which is why
-- 0001 pins the layout with a CHECK on recipes.cover_image_path.
-- =====================================================================

insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
values (
  'recipe-covers',
  'recipe-covers',
  false,
  5242880,                                            -- 5 MB ceiling per object
  array['image/jpeg', 'image/png', 'image/webp']      -- no SVG: it is a script carrier
)
on conflict (id) do update
  set public             = excluded.public,
      file_size_limit    = excluded.file_size_limit,
      allowed_mime_types = excluded.allowed_mime_types;

-- SVG is excluded deliberately. An <svg> served from your own origin can
-- carry <script> and run with your origin's privileges; raster formats
-- cannot.

-- ---------------------------------------------------------------------
-- Read
-- ---------------------------------------------------------------------
drop policy if exists "covers: members read own library" on storage.objects;
create policy "covers: members read own library"
  on storage.objects for select
  to authenticated
  using (
    bucket_id = 'recipe-covers'
    and public.is_valid_cover_path(name)
    and public.is_library_member(((storage.foldername(name))[1])::uuid)
  );

-- The only cross-tenant read that exists: the cover of a recipe whose
-- owner has explicitly set is_public. Scoped to the second path segment,
-- so a public recipe never exposes its neighbours in the same folder.
drop policy if exists "covers: public recipe covers readable" on storage.objects;
create policy "covers: public recipe covers readable"
  on storage.objects for select
  to anon, authenticated
  using (
    bucket_id = 'recipe-covers'
    and public.is_valid_cover_path(name)
    and public.recipe_is_public(((storage.foldername(name))[2])::uuid)
  );

-- ---------------------------------------------------------------------
-- Write — members of the owning library only, and only at a key that
-- matches the pinned layout.
-- ---------------------------------------------------------------------
drop policy if exists "covers: members upload own library" on storage.objects;
create policy "covers: members upload own library"
  on storage.objects for insert
  to authenticated
  with check (
    bucket_id = 'recipe-covers'
    and public.is_valid_cover_path(name)
    and public.is_library_member(((storage.foldername(name))[1])::uuid)
    and owner = (select auth.uid())
  );

drop policy if exists "covers: members replace own library" on storage.objects;
create policy "covers: members replace own library"
  on storage.objects for update
  to authenticated
  using (
    bucket_id = 'recipe-covers'
    and public.is_valid_cover_path(name)
    and public.is_library_member(((storage.foldername(name))[1])::uuid)
  )
  with check (
    bucket_id = 'recipe-covers'
    and public.is_valid_cover_path(name)
    and public.is_library_member(((storage.foldername(name))[1])::uuid)
  );

drop policy if exists "covers: members delete own library" on storage.objects;
create policy "covers: members delete own library"
  on storage.objects for delete
  to authenticated
  using (
    bucket_id = 'recipe-covers'
    and public.is_valid_cover_path(name)
    and public.is_library_member(((storage.foldername(name))[1])::uuid)
  );

-- ---------------------------------------------------------------------
-- No other bucket is created. There is no avatar bucket, no video
-- bucket, no import-scratch bucket. Every additional bucket is another
-- perimeter to police, and the brief calls for zero hosted video.
-- ---------------------------------------------------------------------

-- ---------------------------------------------------------------------
-- Assertion: nothing in public may still mention the word kitchen.
-- ---------------------------------------------------------------------
do $assert$
declare
  v_bad integer;
begin
  select count(*) into v_bad
  from pg_proc p
  join pg_namespace n on n.oid = p.pronamespace
  where n.nspname = 'public'
    and p.prokind = 'f'
    and pg_get_functiondef(p.oid) like '%kitchen%';
  if v_bad > 0 then
    raise exception '0008 incomplete: % function bodies still contain kitchen', v_bad;
  end if;

  select count(*) into v_bad
  from pg_policies
  where schemaname in ('public','storage')
    and (policyname like '%kitchen%'
      or coalesce(qual,'')       like '%kitchen%'
      or coalesce(with_check,'') like '%kitchen%');
  if v_bad > 0 then
    raise exception '0008 incomplete: % policies still contain kitchen', v_bad;
  end if;

  raise notice '0008 ok';
end
$assert$;

commit;
